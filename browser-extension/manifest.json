{
  "manifest_version": 3,
  "name": "YT Downloader Pro Bridge",
  "version": "3.2.2",
  "description": "Gửi video/audio đang phát sang YT Downloader Pro và tải các asset YouTube.",
  "key": "",
  "permissions": [
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://i.ytimg.com/*",
    "https://*.googlevideo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gửi video sang YT Downloader Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; object-src 'self'"
  }
}
